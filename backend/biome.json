{
    "$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 80
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noExplicitAny": "off"
            }
        }
    },
    "javascript": {
      "parser": {
        "unsafeParameterDecoratorsEnabled": true
      },
      "formatter": {
          "quoteStyle": "single",
          "semicolons": "asNeeded",
          "arrowParentheses": "asNeeded",
          "jsxQuoteStyle": "double",
          "trailingCommas": "es5"
      }
    },
    "overrides": [
        {
            "includes": [
                "src/infra/prisma/migrations/**"
            ],
            "linter": {
                "enabled": false
            },
            "formatter": {
                "enabled": false
            }
        }
    ]
}
